# JournalPilot environment template
# Copy values into .env.local for local development. Never commit real secrets.

# Supabase client-safe keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy projects only, if publishable keys are not available yet:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase server-only key
# WARNING: This bypasses normal client-side protections. Use only in server-only
# code paths when privileged Supabase operations are unavoidable.
SUPABASE_SECRET_KEY=
# Legacy projects only, if secret keys are not available yet:
# SUPABASE_SERVICE_ROLE_KEY=

# Prisma ORM 7 / Supabase Postgres
# DATABASE_URL is the pooled runtime connection string used by the app.
DATABASE_URL=
# DIRECT_URL is the direct connection string used by Prisma CLI/migrations.
DIRECT_URL=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Rate limiting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_SALT=

# Email (later feature)
RESEND_API_KEY=
